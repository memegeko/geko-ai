# Copy to .env, generate a random secret, and edit before starting.
BETTER_AUTH_URL=https://chat.example.com
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@example.com
# Comma-separated invited addresses; the admin is always allowed.
ALLOWED_EMAILS=
GEKO_PORT=3000
GEKO_BIND=127.0.0.1
COMPOSE_FILE=compose.yaml
# local starts the bundled Ollama service; empty uses an external endpoint.
COMPOSE_PROFILES=local
GEKO_DOWNLOAD_MODEL=true
# These defaults seed the AI connection only when none is saved.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
DATA_DIR=./data
# Standalone installations may connect directly to a LAN Ollama server.
ALLOW_PRIVATE_OLLAMA=true

# Optional Google OAuth: callback https://chat.example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional GitHub OAuth: callback https://chat.example.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional email verification and password recovery. TLS is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=false
